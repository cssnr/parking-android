<resources>
    <string name="app_name">ParKing</string>

    <!-- ACRA Toast -->
    <string name="acra_toast_text">App crashed and report sent. Disable reporting in Settings.</string>
    <!-- ACRA Disable Dialog -->
    <string name="acra_disable_message">Reports are only sent when the app crashes. This helps fix bugs and no personal data is sent.</string>
    <string name="acra_info_link">https://github.com/cssnr/parking-android#crash-reporting</string>

