<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth permissions - legacy for API < 31 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Runtime permission: getBondedDevices() and ACTION_ACL_DISCONNECTED broadcast on API 31+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Location permissions for recording parking spot -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:ignore="BackgroundLocationPolicy" />

    <!-- Foreground service permissions to capture location on Bluetooth disconnect -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Required for the foreground service notification to be visible on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParKing">

        <!-- Records parking spot when a selected Bluetooth device disconnects. The
             connect is deliberately not handled: the service below is started here
             so its notification only exists for the seconds it takes to read a fix. -->
        <receiver
            android:name=".data.BluetoothDisconnectReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Puts the app in the foreground for the few seconds it takes to read a
             fresh fix. A background app is only offered a new location "a few times
             each hour", which is what stopped a parking spot from ever being
             recorded. It is started from the background by the broadcast above, so
             ACCESS_BACKGROUND_LOCATION has to stay granted. -->
        <service
            android:name=".data.ParkingWatchService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!--android:theme="@style/Theme.ParKing.Starting"-->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
    </manifest>
